generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  SELLER
  SUPPORT
  MEDIATOR
  // Perfis do ERP (Documento Mestre §3). MANAGER segue sendo a Diretoria;
  // CUSTOMER nunca é gravado em User: só aparece na sessão de quem entra
  // pelo Portal do cliente (PortalUser), para a matriz negar tudo.
  SALES_MANAGER
  STOCK
  PURCHASING
  FINANCE
  FISCAL
  MARKETING
  CUSTOMER
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                Role      @default(SELLER)
  jobTitle            String?
  avatarUrl           String?   @db.Text
  birthday            DateTime?
  goal1               Decimal?  @db.Decimal(12, 2)
  goal2               Decimal?  @db.Decimal(12, 2)
  commissionPct1      Decimal?  @db.Decimal(5, 2)
  commissionPct2      Decimal?  @db.Decimal(5, 2)
  // Beyond goal2, commission climbs +0.02 points for every extra
  // commissionStepValue in revenue achieved past goal2 (open-ended).
  commissionStepValue Decimal?  @db.Decimal(12, 2)
  personalGoal        Decimal?  @db.Decimal(12, 2)
  failedLoginAttempts Int       @default(0)
  lockedAt            DateTime?
  // Verificação em duas etapas (TOTP) — mfaSecret fica null enquanto
  // desativada; nunca exposta ao cliente depois de gravada.
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  // Last time this user opened Comunicados — anything posted after this by
  // someone else counts as unread for the Sidebar notification badge.
  lastSeenSocialAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  contacts          Contact[]                 @relation("ContactOwner")
  deals             Deal[]                    @relation("DealOwner")
  activityLogs      ActivityLog[]
  posts             Post[]
  postLikes         PostLike[]
  postComments      PostComment[]
  tasks             Task[]
  prospects         Prospect[]                @relation("ProspectOwner")
  activationReviews ClientActivationRequest[] @relation("ActivationReviewer")

  companies         UserCompany[]
  salesOrders       SalesOrder[]        @relation("OrderSeller")
  approvedOrders    SalesOrder[]        @relation("OrderApprover")
  stockMovements    StockMovement[]
  mailAccounts      MailAccount[]
  mailAccountShares MailAccountAccess[]
  schedules         CustomerSchedule[]
}

enum PersonType {
  FISICA
  JURIDICA
}

enum CommercialPotential {
  ALTO
  MEDIO
  BAIXO
}

enum CrmStatus {
  LEAD
  ATIVO
  INATIVO
}

enum PaymentStatus {
  PENDENTE
  PARCIAL
  PAGO
}

model Contact {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("ContactOwner", fields: [ownerId], references: [id])

  personType       PersonType?
  firstName        String
  lastName         String
  accountName      String?
  cnpj             String?
  email            String?
  phone            String?
  mobile           String?
  residentialPhone String?
  assistantPhone   String?
  leadSource       String?
  supplierName     String?
  jobTitle         String?
  department       String?
  // Free-text category (e.g. "Indústria", "Fábrica", "Revenda") — kept as
  // free text rather than an enum so new categories don't need a code
  // deploy; the filter dropdown is built from whatever distinct values
  // already exist (see listDistinctProfiles).
  profile          String?

  street     String?
  number     String?
  city       String?
  state      String?
  postalCode String?
  latitude   Float?
  longitude  Float?

  // Dados fiscais/financeiros (mesmos campos do Sintegra), preenchidos ao
  // aprovar uma prospecção como cliente ativo — ver ClientActivationRequest.
  inscricaoEstadual String?
  emailFinanceiro   String?
  emailNfe          String?
  enderecoEntrega   String? @db.Text

  // Coletados no "Cliente completo" junto com o restante dos dados fiscais
  // (pedido: "mais informações quando for tornar cliente"). Texto livre nos
  // dois primeiros pelo mesmo motivo do profile acima: novas opções não
  // exigem deploy.
  taxRegime          String?
  companySize        String?
  website            String?
  businessReferences String? @db.Text

  birthday            DateTime?
  commercialPotential CommercialPotential?
  crmStatus           CrmStatus?
  lastContactedAt     DateTime?
  nextContactAt       DateTime?
  notes               String?              @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  deals        Deal[]
  activityLogs ActivityLog[]

  salesOrders    SalesOrder[]
  receivables    Receivable[]
  schedules      CustomerSchedule[]
  portalUsers    PortalUser[]
  portalRequests PortalRequest[]
  mailMessages   MailMessage[]

  @@index([ownerId])
  @@index([deletedAt])
}

model Pipeline {
  id        String          @id @default(cuid())
  name      String
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  stages    PipelineStage[]
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  name       String
  order      Int
  color      String?

  // Marks the stage analytics treats as closed/won revenue (§3.1 KPIs).
  isWon Boolean @default(false)

  // Agenda automation (spec 3.4): the stage that triggers the "on the way"
  // 3-business-day countdown, and which stage it auto-advances into.
  isOnTheWay            Boolean         @default(false)
  autoAdvanceToStageId  String?
  autoAdvanceToStage    PipelineStage?  @relation("AutoAdvance", fields: [autoAdvanceToStageId], references: [id])
  autoAdvanceFromStages PipelineStage[] @relation("AutoAdvance")

  deals Deal[]

  @@index([pipelineId])
}

model Deal {
  id        String        @id @default(cuid())
  ownerId   String
  owner     User          @relation("DealOwner", fields: [ownerId], references: [id])
  contactId String
  contact   Contact       @relation(fields: [contactId], references: [id])
  stageId   String
  stage     PipelineStage @relation(fields: [stageId], references: [id])

  name  String
  value Decimal @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(PENDENTE)
  paymentMethod String?

  onTheWaySince    DateTime?
  onTheWayDeadline DateTime?
  postSaleSentAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  notes             DealNote[]
  activityLogs      ActivityLog[]
  installments      DealInstallment[]
  scheduledMessages Task[]

  @@index([ownerId])
  @@index([contactId])
  @@index([stageId])
  @@index([deletedAt])
}

model DealInstallment {
  id        String    @id @default(cuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id])
  number    Int
  value     Decimal   @db.Decimal(12, 2)
  dueDate   DateTime
  paid      Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([dealId])
}

model DealNote {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id])
  authorId      String?
  body          String?
  attachmentUrl String?
  flagged       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([dealId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  entityType String
  entityId   String
  action     String
  diff       Json?
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id])
  // Empresa do registro auditado (ERP multiempresa); null nos módulos do CRM.
  companyId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([companyId])
}

/**
 * Rede Social mural (spec §3.5): self-hosted, no external API — photos are
 * stored as data URLs, same approach as User.avatarUrl.
 */
model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String?
  imageUrl  String?  @db.Text
  // Mediator-only flag (spec follow-up): highlights a post as an important
  // announcement, surfacing it in the home page's "Comunicados" sidebar card.
  important Boolean  @default(false)
  createdAt DateTime @default(now())

  likes    PostLike[]
  comments PostComment[]

  @@index([authorId])
  @@index([important])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Task {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id])
  title      String
  dueDate    DateTime?
  done       Boolean   @default(false)
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId])
  @@index([dealId])
  @@index([prospectId])
}

enum ProspectTemperature {
  QUENTE
  MORNO
  FRIO
}

enum ActivationStatus {
  PENDENTE
  APROVADO
  RECUSADO
}

/**
 * A coluna do quadro de Prospecções. As 6 primeiras (Prospecção,
 * Conversação, Retorno, Cotação, Negociação, Cliente Ativo) são fixas —
 * isCustom=false, não podem ser renomeadas nem excluídas. Qualquer usuário
 * com acesso de edição pode acrescentar colunas extras (isCustom=true),
 * que ficam sempre depois das fixas e são livremente renomeáveis/excluíveis.
 */
model ProspectStage {
  id            String   @id @default(cuid())
  name          String
  order         Int
  isClientStage Boolean  @default(false)
  isCustom      Boolean  @default(false)
  /**
   * Fase visual que agrupa as etapas no quadro (Captação/Acompanhamento/
   * Cliente para as fixas, "Outros" para colunas extras) e alimenta o
   * filtro por etapa pendente.
   */
  category      String   @default("Outros")
  createdAt     DateTime @default(now())

  prospects   Prospect[]
  stageValues ProspectStageValue[]

  @@index([order])
}

/**
 * Uma linha do quadro (um prospect/lead em captação, antes de virar Contact).
 */
model Prospect {
  id          String              @id @default(cuid())
  ownerId     String
  owner       User                @relation("ProspectOwner", fields: [ownerId], references: [id])
  name        String
  clientName  String
  phone       String?
  email       String?
  temperature ProspectTemperature @default(MORNO)
  profile     String
  notes       String?             @db.Text
  contactDate DateTime

  currentStageId String
  currentStage   ProspectStage @relation(fields: [currentStageId], references: [id])

  convertedContactId String?
  convertedAt        DateTime?
  lastTouchedAt      DateTime  @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stageValues       ProspectStageValue[]
  activationRequest ClientActivationRequest?
  scheduledTasks    Task[]

  @@index([ownerId])
  @@index([currentStageId])
  @@index([deletedAt])
}

/**
 * Uma célula da planilha: o preenchimento (data + observação + concluído)
 * de um prospect numa coluna específica. Uma por combinação prospect+coluna.
 */
model ProspectStageValue {
  id         String        @id @default(cuid())
  prospectId String
  prospect   Prospect      @relation(fields: [prospectId], references: [id])
  stageId    String
  stage      ProspectStage @relation(fields: [stageId], references: [id])
  date       DateTime?
  note       String?       @db.Text
  done       Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([prospectId, stageId])
  @@index([prospectId])
}

/**
 * Preenchido ao mover um prospect pra coluna "Cliente Ativo" — mesmos
 * dados exigidos no Sintegra. Fica pendente até um Mediador aprovar ou
 * recusar; aprovar converte o Prospect num Contact + abre uma Negociação.
 */
model ClientActivationRequest {
  id         String   @id @default(cuid())
  prospectId String   @unique
  prospect   Prospect @relation(fields: [prospectId], references: [id])

  razaoSocial         String
  cnpj                String
  emailFinanceiro     String
  emailNfe            String
  inscricaoEstadual   String
  enderecoFaturamento String  @db.Text
  enderecoEntrega     String  @db.Text
  valor               Decimal @db.Decimal(12, 2)
  condicaoPagamento   String

  // Restante dos campos de Contact (Vendas) — opcionais, coletados junto
  // no "Cliente completo" pra não precisar editar o cliente de novo depois
  // que a aprovação sair. Sem isso o Contact criado só tinha os campos do
  // Sintegra acima.
  personType          PersonType?
  jobTitle            String?
  department          String?
  mobile              String?
  residentialPhone    String?
  assistantPhone      String?
  birthday            DateTime?
  leadSource          String?
  supplierName        String?
  commercialPotential CommercialPotential?
  nextContactAt       DateTime?
  street              String?
  number              String?
  city                String?
  state               String?
  postalCode          String?
  latitude            Float?
  longitude           Float?
  notes               String?              @db.Text
  taxRegime           String?
  companySize         String?
  website             String?
  businessReferences  String?              @db.Text

  status          ActivationStatus @default(PENDENTE)
  reviewerId      String?
  reviewer        User?            @relation("ActivationReviewer", fields: [reviewerId], references: [id])
  rejectionReason String?          @db.Text
  createdAt       DateTime         @default(now())
  decidedAt       DateTime?
  /**
   * Null enquanto o vendedor dono da prospecção ainda não viu o resultado
   * (aprovado/recusado) — alimenta o aviso mostrado no quadro. Marcado ao
   * carregar a página, não precisa disso para status PENDENTE.
   */
  sellerSeenAt    DateTime?

  @@index([status])
}

// ============================================================================
// ERP (Documento Mestre MAX LED). Todo registro operacional, fiscal ou
// financeiro carrega companyId e toda consulta filtra pela empresa ativa da
// sessão (src/lib/erp/company.ts) — trocar de empresa nunca mostra dados da
// anterior. Efeitos colaterais repetíveis (baixa de estoque, títulos, notas,
// pedidos importados) usam chaves únicas de idempotência para que um
// reprocessamento nunca duplique movimentos.
// ============================================================================

enum FiscalEnvironment {
  HOMOLOGACAO
  PRODUCAO
}

model Company {
  id                String  @id @default(cuid())
  code              String  @unique
  name              String
  tradeName         String?
  cnpj              String?
  stateRegistration String?
  taxRegime         String?
  street            String?
  number            String?
  district          String?
  city              String?
  state             String?
  postalCode        String?
  phone             String?
  email             String?
  description       String? @db.Text

  // Parâmetros comerciais (Decisões em aberto §12 — valores padrão
  // ajustáveis em Empresas): pedidos com desconto acima do limite, item
  // abaixo do preço mínimo ou total acima do teto exigem aprovação.
  maxDiscountPct      Decimal  @default(5) @db.Decimal(5, 2)
  approvalAmountLimit Decimal? @db.Decimal(12, 2)

  fiscalEnvironment FiscalEnvironment @default(HOMOLOGACAO)
  fiscalProvider    String            @default("simulador")
  fiscalSeries      Int               @default(1)

  nextOrderNumber    Int @default(1)
  nextPurchaseNumber Int @default(1)
  nextFiscalNumber   Int @default(1)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             UserCompany[]
  products          Product[]
  suppliers         Supplier[]
  salesOrders       SalesOrder[]
  stockMovements    StockMovement[]
  fiscalDocuments   FiscalDocument[]
  receivables       Receivable[]
  payables          Payable[]
  purchaseOrders    PurchaseOrder[]
  schedules         CustomerSchedule[]
  listings          MarketplaceListing[]
  integrationEvents IntegrationEvent[]
  credentials       IntegrationCredential[]
  transfersOut      StockTransfer[]         @relation("TransferFrom")
  transfersIn       StockTransfer[]         @relation("TransferTo")
}

/**
 * Quais empresas cada usuário pode operar. Mediador enxerga todas sem
 * precisar de linha aqui.
 */
model UserCompany {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

enum ProductKind {
  UNIDADE
  PACOTE
  CAIXA
  KIT
}

model Product {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id])
  sku              String
  barcode          String?
  manufacturerCode String?
  name             String
  description      String?     @db.Text
  technicalSpecs   String?     @db.Text
  family           String      @default("Outros")
  category         String?
  brand            String?
  unit             String      @default("UN")
  kind             ProductKind @default(UNIDADE)
  packQty          Int         @default(1)

  ncm    String?
  cest   String?
  origin Int     @default(0)

  cost       Decimal  @default(0) @db.Decimal(12, 4)
  price      Decimal  @default(0) @db.Decimal(12, 2)
  // Os "dois valores mínimos" do protótipo (§12): preço mínimo de venda
  // (abaixo dele o pedido vai para aprovação) e estoque mínimo (alerta de
  // reposição). Confirmar a finalidade com a diretoria.
  minPrice   Decimal? @db.Decimal(12, 2)
  minStock   Int      @default(0)
  reorderQty Int?

  // Saldos mantidos só por src/lib/erp/stock.ts, sempre junto de um
  // StockMovement. Kits (produtos com componentes) não têm saldo próprio:
  // a disponibilidade vem dos componentes.
  stockPhysical Int @default(0)
  stockReserved Int @default(0)
  stockBlocked  Int @default(0)

  weightKg Decimal? @db.Decimal(10, 3)
  lengthCm Decimal? @db.Decimal(10, 2)
  widthCm  Decimal? @db.Decimal(10, 2)
  heightCm Decimal? @db.Decimal(10, 2)

  imageUrl     String? @db.Text
  datasheetUrl String?

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  components    KitComponent[]         @relation("KitParent")
  usedInKits    KitComponent[]         @relation("KitChild")
  movements     StockMovement[]
  orderItems    SalesOrderItem[]
  purchaseItems PurchaseOrderItem[]
  scheduleItems CustomerScheduleItem[]
  listings      MarketplaceListing[]
  suppliers     ProductSupplier[]

  @@unique([companyId, sku])
  @@index([companyId, family])
}

model KitComponent {
  id          String  @id @default(cuid())
  kitId       String
  kit         Product @relation("KitParent", fields: [kitId], references: [id], onDelete: Cascade)
  componentId String
  component   Product @relation("KitChild", fields: [componentId], references: [id])
  quantity    Int

  @@unique([kitId, componentId])
}

model Supplier {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  name         String
  tradeName    String?
  document     String?
  country      String    @default("Brasil")
  currency     String    @default("BRL")
  email        String?
  phone        String?
  contactName  String?
  address      String?   @db.Text
  paymentTerms String?
  leadTimeDays Int?
  rating       Int?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]
  payables       Payable[]

  @@index([companyId])
}

model ProductSupplier {
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku  String?
  lastCost     Decimal? @db.Decimal(12, 4)
  leadTimeDays Int?

  @@id([productId, supplierId])
}

enum StockMovementType {
  ENTRADA
  SAIDA
  RESERVA
  LIBERACAO
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  DEVOLUCAO
  BLOQUEIO
  DESBLOQUEIO
  TRANSFERENCIA_SAIDA
  TRANSFERENCIA_ENTRADA
}

model StockMovement {
  id             String            @id @default(cuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  type           StockMovementType
  quantity       Int
  physicalAfter  Int
  reservedAfter  Int
  blockedAfter   Int
  reason         String?
  documentType   String?
  documentId     String?
  lot            String?
  serial         String?
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())

  @@index([companyId, createdAt])
  @@index([productId, createdAt])
  @@index([documentType, documentId])
}

model StockTransfer {
  id            String   @id @default(cuid())
  fromCompanyId String
  fromCompany   Company  @relation("TransferFrom", fields: [fromCompanyId], references: [id])
  toCompanyId   String
  toCompany     Company  @relation("TransferTo", fields: [toCompanyId], references: [id])
  userId        String
  documentRef   String?
  notes         String?  @db.Text
  requestKey    String   @unique
  items         Json
  createdAt     DateTime @default(now())
}

enum SalesOrderStatus {
  COTACAO
  AGUARDANDO_APROVACAO
  APROVADO
  EM_SEPARACAO
  EM_CONFERENCIA
  PRONTO_EXPEDICAO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum SalesChannel {
  DIRETO
  MERCADO_LIVRE
  PORTAL
  OUTRO
}

model SalesOrder {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id])
  number     Int
  contactId  String
  contact    Contact          @relation(fields: [contactId], references: [id])
  sellerId   String
  seller     User             @relation("OrderSeller", fields: [sellerId], references: [id])
  channel    SalesChannel     @default(DIRETO)
  status     SalesOrderStatus @default(COTACAO)
  externalId String?
  dealId     String?

  paymentMethod String?
  installments  Int     @default(1)
  firstDueDays  Int     @default(30)
  intervalDays  Int     @default(30)

  itemsTotal    Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  freight       Decimal @default(0) @db.Decimal(12, 2)
  otherExpenses Decimal @default(0) @db.Decimal(12, 2)
  total         Decimal @default(0) @db.Decimal(12, 2)

  carrier         String?
  shippingMode    String?
  freightPayer    String?
  billingAddress  String?   @db.Text
  shippingAddress String?   @db.Text
  notes           String?   @db.Text
  internalNotes   String?   @db.Text
  validUntil      DateTime?

  needsApproval   Boolean   @default(false)
  approvalReason  String?   @db.Text
  submittedAt     DateTime?
  approvedById    String?
  approvedBy      User?     @relation("OrderApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?   @db.Text

  stockReservedAt DateTime?
  separatedById   String?
  separatedAt     DateTime?
  checkedById     String?
  checkedAt       DateTime?
  packages        Int?
  grossWeightKg   Decimal?  @db.Decimal(10, 3)
  dimensions      String?
  trackingCode    String?
  shippedById     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  shippingIssue   String?   @db.Text

  cancelledAt  DateTime?
  cancelReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           SalesOrderItem[]
  events          OrderEvent[]
  fiscalDocuments FiscalDocument[]
  receivables     Receivable[]
  mailMessages    MailMessage[]

  @@unique([companyId, number])
  @@unique([channel, externalId])
  @@index([companyId, status])
  @@index([contactId])
  @@index([sellerId])
}

model SalesOrderItem {
  id            String     @id @default(cuid())
  orderId       String
  order         SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Decimal    @db.Decimal(12, 2)
  discountPct   Decimal    @default(0) @db.Decimal(5, 2)
  subtotal      Decimal    @db.Decimal(12, 2)
  unitCost      Decimal    @default(0) @db.Decimal(12, 4)
  belowMinPrice Boolean    @default(false)
  position      Int        @default(0)

  @@index([orderId])
  @@index([productId])
}

/**
 * Linha do tempo do pedido — inclui eventos de integração/sistema (sem
 * usuário), que o ActivityLog não aceita.
 */
model OrderEvent {
  id        String     @id @default(cuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  type      String
  message   String     @db.Text
  createdAt DateTime   @default(now())

  @@index([orderId, createdAt])
}

enum FiscalDocStatus {
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
}

model FiscalDocument {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  orderId         String
  order           SalesOrder        @relation(fields: [orderId], references: [id])
  // Igual ao orderId enquanto a nota não estiver cancelada: garante no
  // banco no máximo uma nota ativa por pedido, mesmo com cliques/reenvios
  // concorrentes.
  activeKey       String?           @unique
  model           String            @default("55")
  series          Int
  number          Int?
  environment     FiscalEnvironment
  provider        String
  status          FiscalDocStatus   @default(PROCESSANDO)
  totalAmount     Decimal           @db.Decimal(12, 2)
  accessKey       String?
  protocol        String?
  xml             String?           @db.Text
  rejectionCode   String?
  rejectionReason String?           @db.Text
  attempts        Int               @default(0)
  authorizedAt    DateTime?
  cancelledAt     DateTime?
  cancelReason    String?           @db.Text
  cancelProtocol  String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  receivables Receivable[]

  @@index([companyId, status])
  @@index([orderId])
}

enum FinancialStatus {
  ABERTO
  PARCIAL
  PAGO
  CANCELADO
}

model Receivable {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  contactId         String
  contact           Contact         @relation(fields: [contactId], references: [id])
  orderId           String?
  order             SalesOrder?     @relation(fields: [orderId], references: [id])
  fiscalDocumentId  String?
  fiscalDocument    FiscalDocument? @relation(fields: [fiscalDocumentId], references: [id])
  installment       Int             @default(1)
  installmentsTotal Int             @default(1)
  description       String
  amount            Decimal         @db.Decimal(12, 2)
  paidAmount        Decimal         @default(0) @db.Decimal(12, 2)
  dueDate           DateTime
  status            FinancialStatus @default(ABERTO)
  paymentMethod     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cancelledAt       DateTime?

  payments ReceivablePayment[]

  @@unique([orderId, installment])
  @@index([companyId, status, dueDate])
  @@index([contactId])
}

model ReceivablePayment {
  id             String     @id @default(cuid())
  receivableId   String
  receivable     Receivable @relation(fields: [receivableId], references: [id])
  amount         Decimal    @db.Decimal(12, 2)
  paidAt         DateTime
  method         String?
  notes          String?
  userId         String
  requestKey     String     @unique
  reconciled     Boolean    @default(false)
  reconciledAt   DateTime?
  reconciledById String?
  createdAt      DateTime   @default(now())

  @@index([receivableId])
}

model Payable {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  supplierId      String?
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  installment     Int             @default(1)
  description     String
  category        String          @default("Outros")
  documentNumber  String?
  amount          Decimal         @db.Decimal(12, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(12, 2)
  dueDate         DateTime
  status          FinancialStatus @default(ABERTO)
  approvedById    String?
  approvedAt      DateTime?
  attachmentUrl   String?         @db.Text
  notes           String?         @db.Text
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cancelledAt     DateTime?

  payments PayablePayment[]

  @@unique([purchaseOrderId, installment])
  @@index([companyId, status, dueDate])
}

model PayablePayment {
  id             String    @id @default(cuid())
  payableId      String
  payable        Payable   @relation(fields: [payableId], references: [id])
  amount         Decimal   @db.Decimal(12, 2)
  paidAt         DateTime
  method         String?
  notes          String?
  userId         String
  requestKey     String    @unique
  reconciled     Boolean   @default(false)
  reconciledAt   DateTime?
  reconciledById String?
  createdAt      DateTime  @default(now())

  @@index([payableId])
}

enum PurchaseStatus {
  SOLICITADO
  COTACAO
  APROVADO
  RECEBIDO_PARCIAL
  RECEBIDO
  CANCELADO
}

model PurchaseOrder {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  number          Int
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  status          PurchaseStatus @default(SOLICITADO)
  isImport        Boolean        @default(false)
  currency        String         @default("BRL")
  exchangeRate    Decimal        @default(1) @db.Decimal(12, 6)
  freight         Decimal        @default(0) @db.Decimal(12, 2)
  insurance       Decimal        @default(0) @db.Decimal(12, 2)
  customsExpenses Decimal        @default(0) @db.Decimal(12, 2)
  importTaxes     Decimal        @default(0) @db.Decimal(12, 2)
  otherExpenses   Decimal        @default(0) @db.Decimal(12, 2)
  // VALOR | QUANTIDADE | PESO — critério de rateio das despesas no custo.
  costAllocation  String         @default("VALOR")
  installments    Int            @default(1)
  firstDueDays    Int            @default(30)
  intervalDays    Int            @default(30)
  expectedAt      DateTime?
  quoteNotes      String?        @db.Text
  notes           String?        @db.Text
  requestedById   String
  approvedById    String?
  approvedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items    PurchaseOrderItem[]
  receipts PurchaseReceipt[]
  payables Payable[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  unitCostForeign Decimal       @db.Decimal(12, 4)
  landedUnitCost  Decimal?      @db.Decimal(12, 4)
}

model PurchaseReceipt {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  requestKey      String        @unique
  invoiceNumber   String?
  notes           String?       @db.Text
  items           Json
  userId          String
  createdAt       DateTime      @default(now())
}

model CustomerSchedule {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id])
  responsibleId String
  responsible   User     @relation(fields: [responsibleId], references: [id])
  title         String
  frequencyDays Int
  nextDate      DateTime
  // TAREFA (só lembra o responsável) | COTACAO (gera cotação rascunho) —
  // nunca baixa estoque (§4.8).
  action        String   @default("COTACAO")
  conditions    String?  @db.Text
  notes         String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items CustomerScheduleItem[]
  runs  CustomerScheduleRun[]

  @@index([companyId, nextDate])
}

model CustomerScheduleItem {
  id         String           @id @default(cuid())
  scheduleId String
  schedule   CustomerSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product          @relation(fields: [productId], references: [id])
  quantity   Int
}

model CustomerScheduleRun {
  id           String           @id @default(cuid())
  scheduleId   String
  schedule     CustomerSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  orderId      String?
  taskId       String?
  createdAt    DateTime         @default(now())

  @@unique([scheduleId, scheduledFor])
}

model PortalUser {
  id                  String    @id @default(cuid())
  contactId           String
  contact             Contact   @relation(fields: [contactId], references: [id])
  name                String
  email               String    @unique
  passwordHash        String
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedAt            DateTime?
  lastLoginAt         DateTime?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requests PortalRequest[]

  @@index([contactId])
}

model PortalRequest {
  id           String     @id @default(cuid())
  contactId    String
  contact      Contact    @relation(fields: [contactId], references: [id])
  portalUserId String
  portalUser   PortalUser @relation(fields: [portalUserId], references: [id])
  type         String
  message      String     @db.Text
  status       String     @default("ABERTA")
  response     String?    @db.Text
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([contactId])
  @@index([status])
}

model MailAccount {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])
  emailAddress  String
  displayName   String?
  imapHost      String
  imapPort      Int       @default(993)
  imapSecure    Boolean   @default(true)
  smtpHost      String
  smtpPort      Int       @default(465)
  smtpSecure    Boolean   @default(true)
  username      String
  // AES-256-GCM (src/lib/erp/crypto.ts). Nunca enviado ao navegador.
  passwordEnc   String    @db.Text
  active        Boolean   @default(true)
  lastSyncAt    DateTime?
  lastSyncError String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shares   MailAccountAccess[]
  messages MailMessage[]

  @@unique([emailAddress])
}

model MailAccountAccess {
  accountId String
  account   MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([accountId, userId])
}

model MailMessage {
  id          String      @id @default(cuid())
  accountId   String
  account     MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder      String
  uid         Int?
  messageId   String?
  inReplyTo   String?
  fromAddr    String
  toAddrs     String      @db.Text
  ccAddrs     String?     @db.Text
  subject     String
  bodyText    String      @db.Text
  date        DateTime
  seen        Boolean     @default(false)
  attachments Json?
  contactId   String?
  contact     Contact?    @relation(fields: [contactId], references: [id])
  orderId     String?
  order       SalesOrder? @relation(fields: [orderId], references: [id])
  sendError   String?     @db.Text
  createdAt   DateTime    @default(now())

  @@unique([accountId, folder, uid])
  @@index([accountId, folder, date])
  @@index([contactId])
  @@index([orderId])
}

model MarketplaceListing {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  channel         SalesChannel @default(MERCADO_LIVRE)
  externalId      String
  title           String
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  // Quantas unidades do produto saem por venda do anúncio (ex.: anúncio
  // "kit 25 LEDs" apontando para o SKU unitário com 25).
  unitsPerSale    Int          @default(1)
  active          Boolean      @default(true)
  lastStockSyncAt DateTime?
  lastSyncError   String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([channel, externalId])
  @@index([companyId])
}

enum IntegrationStatus {
  PENDENTE
  PROCESSADO
  ERRO
  IGNORADO
}

/**
 * Fila/registro de integrações externas: cada notificação ou operação
 * recebe uma chave de idempotência; falhas ficam em ERRO com a mensagem e
 * podem ser reprocessadas sem duplicar efeitos.
 */
model IntegrationEvent {
  id             String            @id @default(cuid())
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id])
  provider       String
  operation      String
  externalId     String?
  idempotencyKey String            @unique
  payload        Json?
  status         IntegrationStatus @default(PENDENTE)
  attempts       Int               @default(0)
  lastError      String?           @db.Text
  resultRef      String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([provider, status])
  @@index([companyId])
}

model IntegrationCredential {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  provider  String
  // JSON cifrado (AES-256-GCM) com tokens/segredos do provedor.
  dataEnc   String   @db.Text
  meta      Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, provider])
}
